# --- added before first push ---
# storage/app/public (product images, logos) IS committed on purpose.
# What follows are the parts of storage/ that must never be published.

# Development backups: full DB dumps, admin/seller password hashes, customer PII.
/storage/*backup*/
/storage/*-backup-*/

# Passport keys - these sign API access tokens.
/storage/oauth-private.key
/storage/oauth-public.key

# Environment-specific: installer marker and the storage symlink.
/storage/installed
/public/uploads

# Large local archives
Archive.zip


# macOS noise
.DS_Store
**/.DS_Store
