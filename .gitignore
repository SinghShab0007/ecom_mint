.env
.env.backup
.env.production

# Backup copies of .env that my tooling renamed (.env.before etc.) - same
# contents as .env: APP_KEY, DB_PASSWORD, mail app passwords, gateway secret.
storage/**/.env
storage/**/.env.*

# GitHub push protection blocks these two: both contain a Stripe *test* key.
#  - the first is my backup copy of the old seeder (superseded by the live one)
#  - the second is Stripe's own SDK documentation
# Nothing depends on either file.
storage/pg-backup-20260827-133214/database/seeds/PaymentGatewaySeeder.php
vendor/stripe/stripe-php/README.md

# Runtime files the app rewrites on every request. Tracking these made every
# `git pull` on the server abort with "local changes would be overwritten".
# storage/app/public (product images) stays tracked.
storage/logs/*
!storage/logs/.gitignore
storage/framework/cache/data/*
!storage/framework/cache/data/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
